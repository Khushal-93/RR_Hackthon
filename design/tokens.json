{
  "name": "Pressure XI Apple Design Tokens (Pink + Royal Blue)",
  "version": "2.0.0",
  "theme": "apple-minimal",
  "brand": "Pressure XI (Rajasthan Royals Hackathon)",
  "palette": {
    "light": {
      "primary": "#2B4ACB",
      "primaryDark": "#1B2F8F",
      "secondary": "#FF5C93",
      "secondaryDark": "#E0487D",
      "softPinkTint": "#FFE4EE",
      "softBlueTint": "#E8EDFF",
      "bgCanvas": "#F5F5F7",
      "bgSurface": "#FFFFFF",
      "bgSubtle": "#F5F5F7",
      "bgMuted": "#E5E5EA",
      "textPrimary": "#1D1D1F",
      "textSecondary": "#6E6E73",
      "textMuted": "#86868B",
      "borderLight": "rgba(0, 0, 0, 0.08)",
      "borderMedium": "rgba(0, 0, 0, 0.14)",
      "borderStrong": "rgba(0, 0, 0, 0.25)",
      "gradientHero": "linear-gradient(135deg, #2B4ACB 0%, #FF5C93 100%)"
    },
    "dark": {
      "primary": "#4C6FFF",
      "primaryDark": "#3A5BE0",
      "secondary": "#FF7AA8",
      "secondaryDark": "#FF5C93",
      "softPinkTint": "rgba(255, 92, 147, 0.15)",
      "softBlueTint": "rgba(76, 111, 255, 0.15)",
      "bgCanvas": "#000000",
      "bgSurface": "#1C1C1E",
      "bgSubtle": "#2C2C2E",
      "bgMuted": "#3A3A3C",
      "textPrimary": "#F5F5F7",
      "textSecondary": "#A1A1A6",
      "textMuted": "#6E6E73",
      "borderLight": "rgba(255, 255, 255, 0.12)",
      "borderMedium": "rgba(255, 255, 255, 0.2)",
      "borderStrong": "rgba(255, 255, 255, 0.35)",
      "gradientHero": "linear-gradient(135deg, #4C6FFF 0%, #FF7AA8 100%)"
    }
  },
  "typography": {
    "fontStack": [
      "-apple-system",
      "BlinkMacSystemFont",
      "\"SF Pro Display\"",
      "\"SF Pro Text\"",
      "\"Inter\"",
      "\"Helvetica Neue\"",
      "Arial",
      "sans-serif"
    ],
    "fontMono": [
      "\"SF Mono\"",
      "ui-monospace",
      "Menlo",
      "Monaco",
      "Consolas",
      "monospace"
    ],
    "heroHeading": {
      "sizeDesktop": "60px",
      "sizeMobile": "40px",
      "weight": 700,
      "letterSpacing": "-0.02em",
      "lineHeight": 1.05
    },
    "sectionHeading": {
      "sizeDesktop": "40px",
      "sizeMobile": "28px",
      "weight": 600,
      "letterSpacing": "-0.015em",
      "lineHeight": 1.15
    },
    "subheading": {
      "sizeDesktop": "26px",
      "sizeMobile": "20px",
      "weight": 500,
      "lineHeight": 1.3
    },
    "bodyText": {
      "size": "17px",
      "weight": 400,
      "lineHeight": 1.47,
      "letterSpacing": "-0.01em"
    },
    "caption": {
      "size": "13px",
      "lineHeight": 1.4
    },
    "button": {
      "size": "17px",
      "weight": 500
    }
  },
  "layout": {
    "maxWidth": "1200px",
    "gridStep": "8px",
    "cardRadius": "22px",
    "cardShadow": "0 8px 30px rgba(0, 0, 0, 0.06)",
    "cardShadowDark": "0 8px 30px rgba(0, 0, 0, 0.35)",
    "cardBorder": "1px solid var(--color-border-light)",
    "buttonRadius": "980px",
    "buttonPadding": "12px 24px"
  },
  "motion": {
    "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "duration": "350ms"
  }
}
