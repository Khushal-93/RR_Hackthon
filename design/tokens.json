{
  "name": "Pressure XI Design Tokens",
  "version": "1.0.0",
  "breakpoints": {
    "mobile": "360px",
    "tablet": "768px",
    "desktop": "1440px"
  },
  "grid": {
    "desktop": {
      "columns": 12,
      "gutter": "24px",
      "margin": "48px",
      "maxWidth": "1344px"
    },
    "tablet": {
      "columns": 8,
      "gutter": "16px",
      "margin": "32px",
      "maxWidth": "704px"
    },
    "mobile": {
      "columns": 4,
      "gutter": "12px",
      "margin": "16px",
      "maxWidth": "328px"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "typography": {
    "fontSans": ["ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
    "fontMono": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"],
    "sizes": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    }
  },
  "themes": {
    "dark": {
      "bg": {
        "canvas": "#0f172a",
        "surface": "#1e293b",
        "subtle": "#334155",
        "muted": "#475569"
      },
      "border": {
        "light": "#334155",
        "medium": "#475569",
        "strong": "#64748b",
        "focus": "#38bdf8"
      },
      "text": {
        "primary": "#f8fafc",
        "secondary": "#94a3b8",
        "muted": "#64748b"
      },
      "accents": {
        "primary": "#38bdf8",
        "batter": "#fbbf24",
        "bowler": "#38bdf8",
        "neutral": "#94a3b8",
        "warning": "#f59e0b",
        "danger": "#f87171",
        "success": "#34d399"
      },
      "tier": {
        "elite": "#34d399",
        "above": "#38bdf8",
        "average": "#94a3b8",
        "below": "#f87171"
      }
    },
    "light": {
      "bg": {
        "canvas": "#f8fafc",
        "surface": "#ffffff",
        "subtle": "#f1f5f9",
        "muted": "#e2e8f0"
      },
      "border": {
        "light": "#e2e8f0",
        "medium": "#cbd5e1",
        "strong": "#94a3b8",
        "focus": "#0284c7"
      },
      "text": {
        "primary": "#0f172a",
        "secondary": "#475569",
        "muted": "#94a3b8"
      },
      "accents": {
        "primary": "#0284c7",
        "batter": "#d97706",
        "bowler": "#0284c7",
        "neutral": "#64748b",
        "warning": "#d97706",
        "danger": "#ef4444",
        "success": "#10b981"
      },
      "tier": {
        "elite": "#059669",
        "above": "#0284c7",
        "average": "#64748b",
        "below": "#dc2626"
      }
    }
  }
}
